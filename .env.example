# Copy to .env in the project root. Never put this key in frontend code.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
TAKEONE_WORKSPACE=workspace
TAKEONE_MAX_UPLOAD_MB=256
TAKEONE_MAX_DURATION_SECONDS=120
TAKEONE_MODEL_TIMEOUT_SECONDS=90
TAKEONE_MAX_QUESTIONS=3
# batch: each round's independent questions are asked together (one call per round); one_at_a_time: one per call.
TAKEONE_RUBRIC_MODE=batch
# Skip the round-closing call when Muse predicted no follow-up. Keep 0 until the prediction is shown to agree with the closing calls.
TAKEONE_RUBRIC_SKIP_CLOSING=0
# Bounded local evidence processing; no model calls per scanned frame.
TAKEONE_SAMPLE_SCAN_FRAMES=96
TAKEONE_SAMPLE_COUNT=8
TAKEONE_SAMPLE_WIDTH=160
TAKEONE_SAMPLE_MEMORY_MB=16
TAKEONE_SAMPLE_IMAGE_KB=1024
TAKEONE_MAX_RENDER_ITERATIONS=3

# Cost shown per video is an ESTIMATE from the usage Meta reports, at these USD rates
# (https://dev.meta.ai/docs/pricing-rate-limits, read 2026-11-03). Change them if Meta changes its prices.
TAKEONE_PRICE_MUSE_INPUT_PER_M=1.25
TAKEONE_PRICE_MUSE_CACHED_INPUT_PER_M=0.15
TAKEONE_PRICE_MUSE_OUTPUT_PER_M=4.25
TAKEONE_PRICE_SAM_PER_1K_FRAMES=0.20
TAKEONE_SAM_MIN_BILLED_FRAMES=50
# One SAM request tracks every area of a localized grade instead of one request per area.
# Off until measured on more footage. An area whose masks do not reproduce its detection masks (mean overlap below the gate) is
# requested on its own, so a failed check costs time and a little money but never quality.
TAKEONE_SAM_SINGLE_PASS=0
TAKEONE_SAM_SINGLE_PASS_GATE=0.85
# How many areas of a localized grade ask SAM at the same time (1-6). 1 is strictly one after another.
TAKEONE_SAM_PARALLEL=3
# Long side, in pixels, of the quick "draft" render. 0 makes drafts full size. Final renders are always the original size.
TAKEONE_DRAFT_LONG_SIDE=1920
# How the evidence table is laid out for Muse's review of a render: rows or columns.
TAKEONE_CRITIC_TABLE_LAYOUT=rows
# Phone footage that is not Rec.709 as recorded (10-bit, full range, untagged, BT.2020) is converted to Rec.709 before grading.
# HDR (HLG / HDR10) is tone-mapped to SDR, an approximation that the interface says so about. 0 refuses HDR instead.
TAKEONE_HDR_TO_SDR=1
